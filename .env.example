# Auth.js - REQUIRED, including for local dev (not just production), or
# every /api/auth/* route 500s. Any random string, e.g. `openssl rand -base64 32`.
AUTH_SECRET=

# X (Twitter) sign-in - optional. Without these, the X sign-in option is
# simply hidden. Create an app at https://developer.x.com, OAuth 2.0,
# callback URL: <your-domain>/api/auth/callback/twitter
AUTH_TWITTER_ID=
AUTH_TWITTER_SECRET=

# Email sign-in - optional. Without this, OTP codes are logged to the
# server console instead of emailed (fine for local dev, not for real
# users). Get a key at https://resend.com.
RESEND_API_KEY=
RESEND_FROM_EMAIL="TheStands <onboarding@resend.dev>"

# Wallet connect (existing) - get a project ID at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Points/leaderboard persistence (existing) - Vercel dashboard -> Storage
# -> Create Database -> KV. Without these, points reset on server restart.
KV_REST_API_URL=
KV_REST_API_TOKEN=
